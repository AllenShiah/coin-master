# Copy to .env and fill in. Docker Compose loads .env via env_file.

# --- LINE Messaging API ---
# LINE Developers Console > Basic settings > Channel secret
LINE_CHANNEL_SECRET=your_channel_secret
# LINE Developers Console > Messaging API > Channel access token.
# Leave blank to run in "log-only" mode (replies are logged, not sent to LINE).
LINE_CHANNEL_ACCESS_TOKEN=

# --- Supabase (PostgREST) ---
# Project Settings > API. Leave both blank to use the in-memory store.
# Use the service_role key so the backend bypasses row-level security.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key

# --- App ---
APP_TIMEZONE=Asia/Taipei
